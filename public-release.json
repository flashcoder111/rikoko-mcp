{
  "paths": [
    "apps/server/src",
    "apps/worker/src",
    "apps/studio/src",
    "apps/studio/index.html",
    "apps/studio/vite.config.ts",
    "apps/studio/package.json",
    "apps/mcp-card/src",
    "apps/mcp-card/vite.config.ts",
    "packages/contracts",
    "packages/bootstrap",
    "packages/core",
    "packages/db",
    "packages/mcp",
    "packages/providers",
    "packages/recipes",
    "packages/render",
    "packages/storage",
    "packages/templates",
    "packages/cloud-client",
    "python/media_core",
    "python/adapters",
    "python/pyproject.toml",
    "python/uv.lock",
    "tests",
    "examples",
    "media-inbox/README.md",
    "scripts/demo.ts",
    "scripts/clients.ts",
    "scripts/setup.ts",
    "scripts/service.ts",
    "scripts/install.sh",
    "scripts/keys.ts",
    "scripts/schemas.ts",
    "config/models.official.example.json",
    "config/models.custom.example.json",
    "config/plans.example.json",
    "docs/integrations",
    "docs/tutorials",
    "docs/architecture/dual-mode.md",
    "docs/architecture/model-services.md",
    "docs/architecture/installation.md",
    "docs/open-source/boundaries.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".env.example",
    ".gitignore",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "vitest.config.ts",
    "AGENTS.md",
    "docs/architecture/repository-layout.md"
  ],
  "exclude": [
    "tests/cloud.test.ts",
    "tests/cloud-runtime.test.ts",
    "tests/cloud-storage.test.ts",
    "tests/model-billing.test.ts",
    "tests/public-export.test.ts",
    "tests/installer-release.test.ts"
  ],
  "readme": "docs/open-source/README.public.md",
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "stdio": "tsx packages/mcp/src/stdio.ts",
    "clients": "tsx scripts/clients.ts",
    "service": "tsx scripts/service.ts",
    "keys": "tsx scripts/keys.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "tsc --noEmit && vite build --config apps/studio/vite.config.ts && vite build --config apps/mcp-card/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:media": "uv run --project python python -m unittest discover -s tests -p '*_test.py'"
  }
}
