{
  "schemaVersion": 1,
  "mode": "custom",
  "providers": [
    {
      "id": "my-fal",
      "adapter": "fal",
      "keyEnv": "MY_FAL_KEY",
      "enabled": false,
      "models": [
        {
          "id": "nano-banana-image",
          "name": "Nano Banana 2 · 图片",
          "description": "示例档案：启用前核对参数和费用",
          "endpoint": "fal-ai/nano-banana-2",
          "kind": "image",
          "maxCostCents": 100,
          "priceVersion": "EXAMPLE-REPLACE-AFTER-PRICING-REVIEW",
          "hardBoundConfirmed": false,
          "parameters": {
            "num_images": 1,
            "aspect_ratio": "16:9",
            "resolution": "1K",
            "output_format": "png"
          },
          "promptField": "prompt"
        },
        {
          "id": "minimax-video",
          "name": "MiniMax H3 · 视频",
          "description": "示例档案：启用前核对参数和费用",
          "endpoint": "minimax/h3/text-to-video",
          "kind": "video",
          "maxCostCents": 100,
          "priceVersion": "EXAMPLE-REPLACE-AFTER-PRICING-REVIEW",
          "hardBoundConfirmed": false,
          "parameters": {
            "duration": 5,
            "resolution": "768P",
            "aspect_ratio": "16:9",
            "prompt_expansion_mode": "disabled",
            "enable_safety_checker": true
          },
          "promptField": "prompt"
        },
        {
          "id": "elevenlabs-voice",
          "name": "ElevenLabs · 配音",
          "description": "示例档案：启用前核对参数和费用",
          "endpoint": "fal-ai/elevenlabs/tts/eleven-v3",
          "kind": "audio",
          "maxCostCents": 100,
          "priceVersion": "EXAMPLE-REPLACE-AFTER-PRICING-REVIEW",
          "hardBoundConfirmed": false,
          "parameters": {
            "voice": "Rachel"
          },
          "promptField": "text",
          "category": "speech"
        },
        {
          "id": "kling-o3-video-edit",
          "name": "Kling O3 Pro · Video editing",
          "description": "Edit 3–15-second MP4/MOV clips with up to 4 character or scene reference images. Preserve source audio and duration. Placeholder cost; review pricing before enabling. Review continuity.",
          "endpoint": "fal-ai/kling-video/o3/pro/video-to-video/edit",
          "kind": "video",
          "maxCostCents": 100,
          "priceVersion": "EXAMPLE-REPLACE-AFTER-PRICING-REVIEW",
          "hardBoundConfirmed": false,
          "parameters": {
            "keep_audio": true
          },
          "generationInput": {
            "mode": "video_to_video",
            "outputDurationSource": "source_video",
            "maxTotalBytes": 41943040,
            "bindings": [
              {
                "field": "video_url",
                "roles": [
                  "source_video"
                ],
                "kind": "video",
                "array": false,
                "min": 1,
                "max": 1,
                "maxBytes": 20971520,
                "mimeTypes": [
                  "video/mp4",
                  "video/quicktime"
                ],
                "containers": [
                  "mp4",
                  "mov"
                ],
                "minDimension": 720,
                "maxDimension": 3840,
                "minDurationMs": 3000,
                "maxDurationMs": 15000
              },
              {
                "field": "image_urls",
                "roles": [
                  "character",
                  "product",
                  "scene",
                  "style",
                  "composition"
                ],
                "kind": "image",
                "array": true,
                "min": 0,
                "max": 4,
                "maxBytes": 10485760,
                "maxPixels": 16777216
              }
            ],
            "referenceSyntax": "kling"
          }
        }
      ]
    },
    {
      "id": "my-replicate",
      "adapter": "replicate",
      "keyEnv": "MY_REPLICATE_TOKEN",
      "enabled": false,
      "models": [
        {
          "id": "flux-image",
          "name": "FLUX Schnell · 图片",
          "description": "示例档案：启用前核对参数和费用",
          "endpoint": "black-forest-labs/flux-schnell",
          "kind": "image",
          "maxCostCents": 100,
          "priceVersion": "EXAMPLE-REPLACE-AFTER-PRICING-REVIEW",
          "hardBoundConfirmed": false,
          "parameters": {
            "num_outputs": 1,
            "aspect_ratio": "16:9",
            "output_format": "png"
          },
          "promptField": "prompt"
        }
      ]
    },
    {
      "id": "my-video-analysis",
      "adapter": "fal-video",
      "keyEnv": "MY_FAL_KEY",
      "enabled": false,
      "models": [
        {
          "id": "gemini-reference",
          "name": "Gemini 3.8 Flash · fal 视频分析",
          "description": "通过 fal 的 OpenRouter 视频接口分析；采样由供应商控制，费用上界启用前核对",
          "endpoint": "openrouter/router/video",
          "kind": "analysis",
          "maxCostCents": 100,
          "priceVersion": "EXAMPLE-REPLACE-AFTER-PRICING-REVIEW",
          "hardBoundConfirmed": false,
          "parameters": {
            "model": "google/gemini-3.8-flash",
            "maxDurationMs": 60000,
            "maxBytes": 83886080,
            "maxOutputTokens": 8192
          }
        }
      ]
    }
  ],
  "templates": {
    "url": "https://templates.example.com"
  }
}
