HOST=127.0.0.1
# Choose official bundled API or config-only provider connections.
# Copy a file from config/models.*.example.json and inject its keyEnv secrets.
# RIKOKO_CONFIG_FILE=config/models.local.json
# RIKOKO_PLANS_FILE=config/plans.local.json
# RIKOKO_OFFICIAL_KEY=<official-user-key>
# MY_FAL_KEY=<personal-fal-key>
# MY_REPLICATE_TOKEN=<personal-replicate-token>
# Template distribution is independent of paid API access; no API balance is needed.
# Templates synchronize only when the user clicks Update or invokes template_sync.
# TEMPLATE_API_URL=https://templates.example.com
# Official generation: inject a unique customer key, never a provider/admin key.
# GENERATION_API_URL=https://api.example.com
# GENERATION_API_KEY=<official-user-key>
# Explicit config mode takes precedence over generation environment variables.
# Legacy CLOUD_API_URL alone only enables templates; adding CLOUD_API_KEY enables generation.
# Config templates.url overrides the template origin; templates=false disables it.
PORT=4310
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATA_DIR=.data
# Leave unset for embedded local PostgreSQL + in-process worker.
# DATABASE_URL=postgresql://workbench:change-me@localhost:5432/workbench
# MEDIA_PYTHON=/absolute/path/to/python/.venv/bin/python
# MEDIA_FONT=/absolute/path/to/a/licensed/font.ttf
# Legacy fal configuration only. A RIKOKO_CONFIG_FILE uses each connection's enabled flag.
ENABLE_PAID_PROVIDERS=false
FAL_KEY=<your-fal-key>
# FAL_MODELS_FILE=deploy/fal-models.local.json
# S3_BUCKET=video-workbench
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# WHISPERX_MODEL_PATH=/models/whisper
# WHISPERX_ALIGN_MODEL_PATH=/models/alignment
# WHISPERX_DEVICE=cpu

# Public root origin, reachable by your Agent host and mobile browser.
# PUBLIC_BASE_URL=https://video.example.com
# Optional web conversation planner; external MCP agents do not need this.
ENABLE_CREATIVE_AGENT=false
# CREATIVE_AGENT_URL=https://your-compatible-service/v1/chat/completions
# CREATIVE_AGENT_MODEL=your-model
# CREATIVE_AGENT_KEY=your-server-only-key
# Planner calls may incur provider charges outside the local render ledger.

# MCP host bridge (normally set by `pnpm clients install <client>`).
# VIDEOWORKBENCH_URL=http://127.0.0.1:4310
# VIDEOWORKBENCH_CLIENT=codex
# VIDEOWORKBENCH_EXPORT_DIR=/absolute/path/to/host-media
# VIDEOWORKBENCH_IMPORT_ROOTS=["/absolute/path/to/media-inbox"]
# Inject VIDEOWORKBENCH_API_KEY through the host secret environment, or use
# VIDEOWORKBENCH_KEYCHAIN_SERVICE on macOS. Never commit real credentials.
