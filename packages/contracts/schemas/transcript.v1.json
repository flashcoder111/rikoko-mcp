{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "language": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600000
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "startMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "endMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "speaker": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "text",
          "startMs",
          "endMs"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "string",
      "enum": [
        "precomputed",
        "local-real",
        "provider-live"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "language",
    "durationMs",
    "words",
    "evidence"
  ],
  "additionalProperties": false
}
