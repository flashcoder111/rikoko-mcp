{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "width": {
      "type": "integer",
      "minimum": 144,
      "maximum": 1920
    },
    "height": {
      "type": "integer",
      "minimum": 144,
      "maximum": 1920
    },
    "fps": {
      "default": 24,
      "anyOf": [
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 30
        }
      ]
    },
    "language": {
      "default": "en",
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 3600000
          },
          "assetId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "audioAssetId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "audioSourceStartMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "sourceStartMs": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "color": {
            "default": "#173b42",
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 1000
          },
          "words": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "speaker": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "required": [
                "id",
                "text",
                "startMs",
                "endMs"
              ],
              "additionalProperties": false
            }
          },
          "fit": {
            "default": "contain",
            "type": "string",
            "enum": [
              "contain",
              "cover"
            ]
          },
          "volume": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "speed": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4
          },
          "volumeEnvelope": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timeMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "gain": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "timeMs",
                "gain"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "durationMs",
          "sourceStartMs",
          "color",
          "text",
          "fit",
          "volume"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "default": [],
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "sceneId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "wordId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "offsetMs": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "durationMs": {
            "type": "integer",
            "minimum": 50,
            "maximum": 3600000
          },
          "kind": {
            "type": "string",
            "enum": [
              "card",
              "text",
              "broll"
            ]
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "assetId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          }
        },
        "required": [
          "id",
          "sceneId",
          "offsetMs",
          "durationMs",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "captionStyle": {
      "default": {
        "fontSize": 28,
        "color": "#ffffff",
        "background": "#151a22"
      },
      "type": "object",
      "properties": {
        "fontSize": {
          "default": 28,
          "type": "integer",
          "minimum": 12,
          "maximum": 96
        },
        "color": {
          "default": "#ffffff",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "default": "#151a22",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "fontSize",
        "color",
        "background"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "toneHz": {
          "type": "number",
          "minimum": 40,
          "maximum": 1000
        },
        "gain": {
          "default": 0.1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "gain"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "width",
    "height",
    "fps",
    "language",
    "scenes",
    "events",
    "captionStyle"
  ],
  "additionalProperties": false
}
