{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "reference_analyze"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "purpose": {
          "default": "remake",
          "type": "string",
          "enum": [
            "remake",
            "clip",
            "inspect"
          ]
        },
        "language": {
          "default": "zh",
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "range": {
          "type": "object",
          "properties": {
            "startMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000
            },
            "endMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000
            }
          },
          "required": [
            "startMs",
            "endMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "assetId",
        "model",
        "purpose",
        "language"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "render"
        },
        "composition": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "width": {
              "type": "integer",
              "minimum": 144,
              "maximum": 1920
            },
            "height": {
              "type": "integer",
              "minimum": 144,
              "maximum": 1920
            },
            "fps": {
              "default": 24,
              "anyOf": [
                {
                  "type": "number",
                  "const": 24
                },
                {
                  "type": "number",
                  "const": 25
                },
                {
                  "type": "number",
                  "const": 30
                }
              ]
            },
            "language": {
              "default": "en",
              "type": "string",
              "minLength": 2,
              "maxLength": 20
            },
            "scenes": {
              "minItems": 1,
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  },
                  "assetId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "audioAssetId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "audioSourceStartMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "sourceStartMs": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "color": {
                    "default": "#173b42",
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "text": {
                    "default": "",
                    "type": "string",
                    "maxLength": 1000
                  },
                  "words": {
                    "maxItems": 500,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "startMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 3600000
                        },
                        "endMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 3600000
                        },
                        "speaker": {
                          "type": "string",
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "id",
                        "text",
                        "startMs",
                        "endMs"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "fit": {
                    "default": "contain",
                    "type": "string",
                    "enum": [
                      "contain",
                      "cover"
                    ]
                  },
                  "volume": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 4
                  },
                  "volumeEnvelope": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "timeMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 3600000
                        },
                        "gain": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "timeMs",
                        "gain"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "durationMs",
                  "sourceStartMs",
                  "color",
                  "text",
                  "fit",
                  "volume"
                ],
                "additionalProperties": false
              }
            },
            "events": {
              "default": [],
              "maxItems": 300,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "sceneId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "wordId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "offsetMs": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 3600000
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "card",
                      "text",
                      "broll"
                    ]
                  },
                  "text": {
                    "default": "",
                    "type": "string",
                    "maxLength": 200
                  },
                  "assetId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  }
                },
                "required": [
                  "id",
                  "sceneId",
                  "offsetMs",
                  "durationMs",
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "captionStyle": {
              "default": {
                "fontSize": 28,
                "color": "#ffffff",
                "background": "#151a22"
              },
              "type": "object",
              "properties": {
                "fontSize": {
                  "default": 28,
                  "type": "integer",
                  "minimum": 12,
                  "maximum": 96
                },
                "color": {
                  "default": "#ffffff",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "background": {
                  "default": "#151a22",
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": [
                "fontSize",
                "color",
                "background"
              ],
              "additionalProperties": false
            },
            "audio": {
              "type": "object",
              "properties": {
                "assetId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                },
                "toneHz": {
                  "type": "number",
                  "minimum": 40,
                  "maximum": 1000
                },
                "gain": {
                  "default": 0.1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "gain"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "title",
            "width",
            "height",
            "fps",
            "language",
            "scenes",
            "events",
            "captionStyle"
          ],
          "additionalProperties": false
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        }
      },
      "required": [
        "kind",
        "composition"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "trim"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "segments": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              }
            },
            "required": [
              "startMs",
              "endMs"
            ],
            "additionalProperties": false
          }
        },
        "width": {
          "default": 360,
          "type": "integer",
          "minimum": 144,
          "maximum": 1920
        },
        "height": {
          "default": 640,
          "type": "integer",
          "minimum": 144,
          "maximum": 1920
        }
      },
      "required": [
        "kind",
        "assetId",
        "segments",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "captions"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "transcript": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "number",
              "const": 1
            },
            "language": {
              "type": "string"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600000
            },
            "words": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "startMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "endMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600000
                  },
                  "speaker": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "id",
                  "text",
                  "startMs",
                  "endMs"
                ],
                "additionalProperties": false
              }
            },
            "evidence": {
              "type": "string",
              "enum": [
                "precomputed",
                "local-real",
                "provider-live"
              ]
            }
          },
          "required": [
            "schemaVersion",
            "language",
            "durationMs",
            "words",
            "evidence"
          ],
          "additionalProperties": false
        },
        "style": {
          "type": "object",
          "properties": {
            "fontSize": {
              "type": "integer",
              "minimum": 12,
              "maximum": 96
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "fontSize",
            "color"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "assetId",
        "transcript"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "transcribe"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "language": {
          "default": "en",
          "type": "string",
          "maxLength": 20
        }
      },
      "required": [
        "kind",
        "assetId",
        "language"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tts"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "language": {
          "default": "en",
          "type": "string",
          "maxLength": 20
        },
        "voice": {
          "default": "default",
          "type": "string",
          "pattern": "^[\\w -]{1,80}$"
        },
        "engine": {
          "default": "local",
          "type": "string",
          "enum": [
            "local",
            "fal"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "kind",
        "text",
        "language",
        "voice",
        "engine"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "generate"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "parameters": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "image_edit",
            "image_to_video",
            "first_last_frame",
            "reference_to_video",
            "video_to_video"
          ]
        },
        "references": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "assetId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "composition",
                  "character",
                  "product",
                  "scene",
                  "style",
                  "first_frame",
                  "last_frame",
                  "motion",
                  "voice",
                  "source_video"
                ]
              }
            },
            "required": [
              "assetId",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "storyboard": {
          "type": "object",
          "properties": {
            "storyboardId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sourceShotId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,100}$"
            },
            "stage": {
              "type": "string",
              "enum": [
                "image",
                "video"
              ]
            }
          },
          "required": [
            "storyboardId",
            "version",
            "sourceShotId",
            "stage"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "model",
        "prompt",
        "parameters"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "translate"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        }
      },
      "required": [
        "kind",
        "model",
        "text",
        "language"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "analyze"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "observations": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              },
              "endMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600000
              },
              "observation": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "startMs",
              "endMs",
              "observation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "assetId"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
